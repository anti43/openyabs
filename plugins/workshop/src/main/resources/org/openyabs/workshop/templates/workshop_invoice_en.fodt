<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
                 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
                 xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
                 office:version="1.2"
                 office:mimetype="application/vnd.oasis.opendocument.text">
  <office:body>
    <office:text>
      <text:p>[companyinfo.name] – [companyinfo.street], [companyinfo.zip] [companyinfo.city]</text:p>
      <text:p>[contact.cname]</text:p>
      <text:p>[contact.street], [contact.zip] [contact.city]</text:p>
      <text:h text:outline-level="1">Workshop Invoice [item.cnumber]</text:h>
      <text:p>Invoice Date: [item.dateadded] | Linked Quote: [ws.quoteNumber] ([ws.quoteTotal])</text:p>
      <text:p>Vehicle: [ws.makeModel] | License Plate: [ws.plate] | VIN: [ws.vin]</text:p>
      <text:p>First Registration: [ws.firstRegistration] | HSN/TSN: [ws.hsnTsn] | Next Inspection: [ws.inspectionDue]</text:p>
      <text:p>Mileage at Drop-off: [ws.mileage] [ws.mileageUnit] | Drop-off: [ws.dropoffDate] | Pickup: [ws.pickupDate]</text:p>
      <text:p>Customer Complaint: [ws.complaint]</text:p>
      <text:p>Work Summary: [ws.workSummary]</text:p>
      <text:p>Old Parts: [ws.oldParts] | Labor Billing: [ws.awDefinition]</text:p>
      <text:p>[xtable1]</text:p>
      <text:p>Net Total: [item.netvalue] | Tax: [item.taxvalue] | Gross Total: [item.totalvalue]</text:p>
    </office:text>
  </office:body>
</office:document>
